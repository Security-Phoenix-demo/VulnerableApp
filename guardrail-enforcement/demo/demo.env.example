# demo.env.example — settings for demo-guardrail-enforcement.sh
#
# HOW TO USE
#   cp demo.env.example demo.env
#   edit demo.env, put your real token in it
#   ./demo-guardrail-enforcement.sh          # it loads demo.env automatically
#
# NEVER COMMIT demo.env. It is in the repository .gitignore, and this example
# file holds placeholders only. Put the real token in demo.env, never here.
#
# PRECEDENCE, strongest first:
#   1. a command-line flag           (--mode, --target, --port)
#   2. a variable already exported in your shell
#   3. this file
#   4. the script's built-in default
# So an exported PHX_API_TOKEN always beats the one written here.

# ---------------------------------------------------------------------------
# Phoenix Security credentials — used by --mode live
# ---------------------------------------------------------------------------

# Your Phoenix API token. REQUIRED for --mode live, ignored by --mode mock.
# The gate sends it as `Authorization: Bearer <token>`.
# It must match [A-Za-z0-9._-] — the gate refuses anything else without sending it.
PHX_API_TOKEN=replace-with-your-token

# Which Phoenix to talk to. Exactly one uncommented.
#
#   local       http://localhost:4300        the app on this machine
#   poc         https://poc1.purple.appsecphx.io
#   production  https://phxpurple.securityphoenix.cloud
#
# A token is issued per environment. A production token will 401 against the
# POC host and vice versa, and the gate reports that as BACKEND UNREACHABLE —
# which is a SKIP, not a pass. If the demo says "gate skipped", check this
# pairing before anything else.
PHX_API_BASE=http://localhost:4300
#PHX_API_BASE=https://poc1.purple.appsecphx.io
#PHX_API_BASE=https://phxpurple.securityphoenix.cloud

# Optional. Baked into the gate. Leave blank to let the backend decide.
PHX_ORG_ID=
PHX_WORKSPACE_ID=

# ---------------------------------------------------------------------------
# Demo behaviour — every one of these has a matching command-line flag
# ---------------------------------------------------------------------------

# live = real Phoenix backend (needs PHX_API_TOKEN and PHX_DEMO_TARGET)
# mock = local fake backend, no token, no network
PHX_DEMO_MODE=mock

# Repo to demo against. REQUIRED for live mode: it must already be onboarded in
# Phoenix, or the scan resolve call fails and the gate SKIPS. The repo is cloned
# to a temp directory; your working copy is never touched.
PHX_DEMO_TARGET=

# Port for the local mock API.
PHX_DEMO_PORT=4250

# The dummy token mock mode exports so the gate does not skip on a missing one.
# It is NOT a credential. It never leaves the machine — the mock server is local
# and ignores it. It only has to satisfy the gate's [A-Za-z0-9._-] charset check.
PHX_DEMO_MOCK_TOKEN=mockdemotoken

# The enforcement policy the installer bakes into the gate.
PHX_DEMO_POLICY_MODE=BLOCK
PHX_DEMO_BLOCKING_SEVERITIES=["CRITICAL","HIGH"]
