{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-$PWD}\" && bash scripts/purplephx-gate.sh",
            "timeout": 180,
            "statusMessage": "Phoenix Purple: checking against enforcement policy before commit/push..."
          },
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-$PWD}\" && PHX_GATE_TIMEOUT_SECONDS=180 bash scripts/purplephx-gate.sh",
            "timeout": 180,
            "statusMessage": "Phoenix Purple: checking against enforcement policy before push/PR..."
          }
        ]
      }
    ]
  }
}
